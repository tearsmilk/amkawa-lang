# обычная программа на Aminakawa — никакого Discord

tyan line(label, value) {
  back label + ": " + value
}

tyan square(x) {
  back x * x
}

name = "tearsmilk"
roles = ["designer", "developer", "prompt-engineer"]

nya("=== профиль ===")
nya(line("имя", name))

num = 0
for r in roles {
  num = num + 1
  nya(num, "-", r)
}
nya("всего ролей:", len(roles))

nya("")
nya("=== немного математики ===")
for i in range(1, 6) {
  nya(i, "в квадрате =", square(i))
}

nya("")
nya("=== чётные/нечётные до 6 ===")
for k in range(1, 7) {
  moshi k % 2 == 0 {
    nya(k, "чётное")
  } else {
    nya(k, "нечётное")
  }
}
