{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aminakawa",
  "scopeName": "source.amkawa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#funcdef" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#call" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.amkawa"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.amkawa",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.amkawa", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.amkawa",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.amkawa", "match": "\\\\." }]
        }
      ]
    },
    "funcdef": {
      "match": "\\b(tyan)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.amkawa" },
        "2": { "name": "entity.name.function.amkawa" }
      }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.amkawa", "match": "\\b(moshi|else|while|for|in|back)\\b" },
        { "name": "keyword.operator.word.amkawa", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "constants": {
      "match": "\\b(hai|iie|mu)\\b",
      "name": "constant.language.amkawa"
    },
    "builtins": {
      "match": "\\b(nya|len|num|str|ask|range|push|bot|on_message|say|run)\\b",
      "name": "support.function.builtin.amkawa"
    },
    "numbers": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.amkawa"
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.amkawa" } }
    }
  }
}
