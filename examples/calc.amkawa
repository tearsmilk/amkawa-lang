# ================================
#   Калькулятор на Aminakawa
#   запуск:  python amkawa.py calc.amkawa
# ================================

# считает одно действие и возвращает результат
tyan посчитать(a, op, b) {
  moshi op == "+" { back a + b }
  moshi op == "-" { back a - b }
  moshi op == "*" { back a * b }
  moshi op == "/" {
    moshi b == 0 { back mu }   # mu = "ничего", знак что деление на ноль
    back a / b
  }
  back mu                      # неизвестное действие
}

nya("=== Калькулятор ===")
nya("действия:  +   -   *   /")
nya("")

ещё = "да"
while ещё == "да" {
  a  = num(ask("Первое число:  "))
  op = ask("Действие (+ - * /):  ")
  b  = num(ask("Второе число:  "))

  ответ = посчитать(a, op, b)

  moshi ответ == mu {
    moshi op == "/" and b == 0 {
      nya(">> на ноль делить нельзя!")
    } else {
      nya(">> не знаю такое действие:", op)
    }
  } else {
    nya(">>", a, op, b, "=", ответ)
  }

  nya("")
  ещё = ask("Посчитать ещё? (да / нет):  ")
  nya("")
}

nya("Пока! nya~")
